# PayPal SANDBOX credentials (developer.paypal.com > Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
# AI investigator. Free option: Groq key from console.groq.com/keys. Without any key it runs a deterministic offline analyst.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Or Anthropic (paid API, separate from claude.ai plans):
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Public URL of this app (PayPal redirects buyers back here)
BASE_URL=http://localhost:8000
# sqlite by default; use a Postgres URL on Render
DATABASE_URL=sqlite:///./ringhunter.db
