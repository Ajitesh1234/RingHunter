# PayPal SANDBOX credentials (developer.paypal.com > Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
# Public URL of this app (PayPal redirects buyers back here)
BASE_URL=http://localhost:8000
# sqlite by default; use a Postgres URL on Render
DATABASE_URL=sqlite:///./ringhunter.db
# Authorize first, then screen, then capture or hold. The deployed demo uses "on".
SCREENING=off
# Locks state-changing endpoints. REQUIRED on Render: without it those endpoints return 503.
ADMIN_TOKEN=
# The server decides the price
PRODUCT_PRICE=25.00
# AI analyst and red team. Free option: Groq key from console.groq.com/keys. Without any key the offline analyst runs.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Or Anthropic (paid API, separate from claude.ai plans):
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
